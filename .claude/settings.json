{
  "permissions": {
    "deny": [
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(aws lightsail delete-*)",
      "Bash(dropdb *)",
      "Bash(cat .env)",
      "Bash(printenv *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(aws *)",
      "Bash(psql *)",
      "Bash(alembic downgrade *)",
      "Bash(rm -rf *)"
    ],
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(pip install -r *)",
      "Bash(python scripts/env_status.py)",
      "Bash(alembic upgrade head)",
      "Bash(alembic current)",
      "Bash(alembic history *)",
      "Bash(alembic revision *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block_secret_commit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
